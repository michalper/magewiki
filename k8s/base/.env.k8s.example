# Copy to k8s/base/.env.k8s (gitignored) and fill in. Consumed by kustomization.yaml's
# secretGenerator -> Secret/magewiki-secrets. Mirrors the root .env.example's secret-bearing
# vars; see that file for the full set of non-secret config (in k8s/base/configmap.yaml instead).

POSTGRES_USER=magewiki
POSTGRES_PASSWORD=changeme
POSTGRES_DB=magewiki
DATABASE_URL=postgresql+asyncpg://magewiki:changeme@db:5432/magewiki

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
WEBHOOK_HMAC_SECRET=
