namespace Magento\Framework\App\Action {
    interface HttpGetActionInterface
    {
    }

    interface HttpPostActionInterface
    {
    }

    class Context
    {
        public function getRequest()
        {
        }

        public function getMessageManager()
        {
        }

        public function getResultRedirectFactory()
        {
        }
    }

    // Base of the real admin-controller inheritance chain every scanned
    // module's own AbstractCampaignAction-style base class extends through
    // Magento\Backend\App\Action below — getRequest()/$resultRedirectFactory/
    // $messageManager are genuinely inherited from here in real Magento, not
    // dynamic properties, so PHPStan needs them declared on the base, not on
    // every concrete controller that happens to reference them.
    class Action
    {
        protected $_request;
        protected $resultRedirectFactory;
        protected $messageManager;

        public function __construct(Context $context)
        {
        }

        public function getRequest()
        {
        }
    }
}

