# Production image for the Fly deployment -- the existing Dockerfile stays
# untouched for local docker-compose dev (bind-mounted source, `npm run
# dev`). This one does a real `next build` with Next's "standalone" output
# (next.config.ts) so the final image only carries the minimal self-
# contained server, not the whole node_modules/source tree.
FROM node:26-slim AS builder
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
# public/ has no tracked files (git never commits an empty directory), so
# a fresh clone -- like CI's checkout, unlike a local working tree that
# still has the directory sitting on disk from scaffolding -- has no
# public/ at all. Without this, the runner stage's COPY below fails with
# "/app/public": not found (confirmed directly: this broke the very first
# CI run of this Dockerfile).
RUN mkdir -p public

# NEXT_PUBLIC_* vars are inlined into the client JS at build time, not read
# at runtime -- this has to be a build arg, not just a Fly runtime secret/
# env var, or every client-side apiFetch() call would silently fall back
# to apiUrl()'s localhost:8000 default.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# Used by app/layout.tsx's metadataBase, so the og:image/twitter:image meta
# tags point at a real, publicly-reachable URL instead of localhost.
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
RUN npm run build

FROM node:26-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000
CMD ["node", "server.js"]
