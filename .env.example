# --- Phase 0: used today ---
POSTGRES_USER=magewiki
POSTGRES_PASSWORD=changeme
POSTGRES_DB=magewiki
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://magewiki:changeme@db:5432/magewiki

API_PORT=8000
CORS_ORIGINS=http://localhost:3000

WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Browser-facing only — fetches from inside the `web` container itself (e.g.
# generateMetadata for a dynamic page title) need the compose service name
# instead, since "localhost" there means the web container, not the api one.
# Optional: defaults to http://api:8000, uncomment only if that's ever wrong.
# API_INTERNAL_URL=http://api:8000

# --- Phase 1: scanner demo & real-fixture tests (optional, machine-specific) ---
# Absolute host paths to local checkouts of the two public test fixtures (see
# CLAUDE.md "Test data"), bind-mounted read-only into the api container at the
# identical path. Leave unset to skip the real-fixture tests (they skip
# gracefully) and to disable the demo-scan mount.
MAGEWIKI_ORDO_FIXTURE_PATH=
MAGEWIKI_MAGENTO_FIXTURE_PATH=

# --- General-purpose scan roots (what repos can I scan on this server?) ---
# Unlike the two fixture paths above (which name one specific repo each, for
# tests/eval), these are general directories: set one per top-level location on
# this host where scannable Magento stores/modules live (e.g. /srv/repos or
# /home/you/projects), and ANY repo added under it becomes scannable via the UI
# or webhook immediately — no further docker-compose edits or restarts needed.
# Bind-mounted read-only at the identical path inside api/worker/php-analyzer.
# Numbered (not a comma list) because docker-compose.yml can't loop; need more
# than 3 unrelated top-level locations (rare) — add more lines to
# docker-compose.yml directly. GET /scan-roots reports what's currently
# configured.
MAGEWIKI_SCAN_ROOT_1=
MAGEWIKI_SCAN_ROOT_2=
MAGEWIKI_SCAN_ROOT_3=

# --- Phase 2: queue (ARQ + Redis) — analyze_file is a stub until Phase 3 ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Phase 3: AI analysis (LiteLLM; Anthropic for this phase — see CLAUDE.md deviation note) ---
LLM_MODEL=anthropic/claude-haiku-5-5
# Optional: a stronger model for module-level synthesis only (analyze_file's per-file
# summaries stay on LLM_MODEL). Empty = same as LLM_MODEL. Must use the same provider
# as LLM_MODEL — it reuses LLM_MODEL's api key/base. See CLAUDE.md's dependency
# refresh / reliability note for why this exists.
SYNTHESIS_MODEL=
ANTHROPIC_API_KEY=
LLM_MONTHLY_BUDGET_USD=20

# Dormant BYOK placeholders for a later phase (CLAUDE.md's stated production default remains DeepSeek/BYOK):
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Phase 4: embeddings (LiteLLM; OpenAI), configured separately from the LLM ---
EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_API_KEY=
# Must match EMBEDDING_MODEL's real output dimension — the chunks.embedding pgvector
# column is fixed at this dimension by the migrations (changing it requires a full
# re-embed, since vectors from different models aren't comparable). Known values:
# 1536 = openai/text-embedding-3-small or -ada-002; 1024 = bge-m3 (Ollama).
EMBEDDING_DIMENSIONS=1536

# --- Phase 6+: webhook trigger for scan_repository ---
WEBHOOK_HMAC_SECRET=

# --- Phase 12: PHP static-analysis sidecar (PHPStan/PHPMD/phpcs/Rector) ---
PHP_ANALYZER_URL=http://php-analyzer:8080

# --- Phase 9: license_risk check (app/scanner/license_check.py) ---
# Composer license prefixes the scanner treats as "risky" (strong-copyleft,
# real redistribution obligations for a commercial store) — comma-separated,
# case-insensitive. Empty disables the check entirely. This is a legal/
# business judgment call, not a technical one — the default below (GPL/AGPL/
# SSPL) is this project's own opinion, not a universal standard.
LICENSE_RISK_PREFIXES=GPL-,AGPL-,SSPL-

# --- RAG: optional, budget-gated retrieval optimizations (app/search/) ---
# Each is a real per-query LLM cost, off by default so enabling either is a
# deliberate operator choice against LLM_MONTHLY_BUDGET_USD, not a silent
# cost increase on every chat search. Independent of each other: reranking
# reorders what retrieval found; query rewriting reformulates the query
# before retrieval runs.
RERANK_ENABLED=false
QUERY_REWRITE_ENABLED=false

# --- Phase 18: quality-alert webhook (app/scanner/alerts.py) ---
# Fires one webhook POST per scan_repository run when an alert-worthy
# check_type's finding count goes up for any module since its last scan --
# e.g. a new hardcoded secret or a new real CVE. Empty disables the whole
# feature. Point this straight at a Slack Incoming Webhook URL (the payload
# carries a top-level "text" field), Discord, Zapier/n8n, or anything else
# that takes a JSON POST.
ALERT_WEBHOOK_URL=
# Comma-separated check_type keys that count as "compromising" enough to
# alert on -- deliberately narrow (secrets + real CVEs), not routine
# PHPStan/PHPMD churn, or this would be noisy enough to ignore.
ALERT_CHECK_TYPES=hardcoded_secret,security_advisory
